# cc-service instance configuration
# Copy to /etc/cc-service/<instance-name>.env — install.sh does this for you.

# --- Identity ---
CC_INSTANCE_NAME="default"          # logical name; used to derive unit names, log prefixes
CC_PROJECT_DIR="/path/to/project"   # `cd` target before launching claude; must exist
CC_TMUX_SESSION="claude"            # tmux session name (must be unique on the box)
CC_CLAUDE_NAME="$HOSTNAME"          # value passed to `claude --name`; empty = omit flag

# --- Permission mode (SAFE DEFAULT: unset = normal prompting) ---
CC_PERMISSION_MODE=""               # "" (default, safe) | "auto" | "plan" | "acceptEdits" | any
                                     # valid --permission-mode value. Empty => flag omitted entirely.
                                     # Only set this to "auto" if you understand it removes tool-use
                                     # confirmation prompts. See README "Security notes".

# --- Credential hook ---
CC_CRED_HOOK=""                     # absolute path to an optional shell script, `source`d
                                     # by claude-daemon.sh before each `claude` launch.
                                     # e.g. /etc/cc-service/default-cred-hook.sh containing:
                                     #   export OP_SERVICE_ACCOUNT_TOKEN=$(cat ~/.op-token)
                                     # Left empty => skipped. install.sh chmod 0500s it.

# --- Startup / restart behavior ---
CC_STARTUP_DELAY_SEC=15             # sleep before the *first* `claude --continue` post-boot,
                                     # gives the server time to expire a stale pre-reboot
                                     # Remote Control registration before we'd collide with it
CC_RESPAWN_DELAY_SEC=3              # sleep between claude exits and next launch, in the loop
CC_CLAUDE_EXTRA_ARGS=""             # opaque extra args appended verbatim (advanced/escape hatch)

# --- Watchdog ---
CC_WATCHDOG_ENABLED="true"          # if false, the watchdog unit is not installed/started
CC_WATCHDOG_INTERVAL_SEC=60         # poll interval
CC_WATCHDOG_PANE_LINES=60           # how many lines of scrollback to capture/inspect each poll
CC_WATCHDOG_BACKOFF_BASE_SEC=30     # exponential backoff base after a failed self-heal attempt
CC_WATCHDOG_BACKOFF_MAX_SEC=1800    # cap (30 min)
CC_WATCHDOG_MAX_CONSECUTIVE_ATTEMPTS=6   # after this many un-resolved attempts in a row, stop
                                          # trying and just log at ERROR every interval until
                                          # state changes or the process restarts
CC_WATCHDOG_IDLE_QUIET_SEC=5        # pane content must be unchanged for this long before we
                                     # consider it "idle" (avoids sending keys mid-render)

# --- Logging ---
CC_LOG_DIR="/var/log/cc-service"    # daemon.log, watchdog.log written here (also journald)
CC_LOG_LEVEL="info"                 # debug|info|warn|error
