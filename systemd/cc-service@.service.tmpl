[Unit]
Description=cc-service always-on Claude Code daemon (%i)
Documentation=https://github.com/thejameswoods/cc-service
After=network-online.target
Wants=network-online.target
# Do NOT rate-limit restarts (default systemd burst window would give up
# and leave the daemon dead during a flapping network/outage). RestartSec
# below still throttles the actual retry pace.
StartLimitIntervalSec=0

[Service]
# Type=forking, not simple: tmux new-session in the foreground needs a
# controlling TTY, which doesn't exist under systemd ("open terminal
# failed: not a terminal") -- confirmed by a live install attempt during
# development. -d detaches immediately after creating the session, which
# is exactly the fork-and-exit shape Type=forking expects; systemd tracks
# the real daemon process via the unit's cgroup.
Type=forking
User={{RUN_AS_USER}}
Environment=HOME={{RUN_AS_HOME}}
# CC_CONFIG_PATH here is a documentation/fallback aid only. The real,
# reliable path is the explicit argv below: when a tmux server for this OS
# user already exists (another instance, or a pre-existing always-on
# session), a new session on it inherits THAT SERVER's environment, not
# this unit's Environment= -- confirmed live. Argv always passes through
# tmux new-session exactly as given, regardless of which server handles it.
Environment=CC_CONFIG_PATH=/etc/cc-service/%i.env
WorkingDirectory={{CC_PROJECT_DIR}}
# -L gives this instance its own dedicated tmux server/socket rather than
# sharing the OS user's default one -- required so Type=forking's cgroup
# based PID tracking actually finds this instance's process tree instead
# of an unrelated pre-existing server's (confirmed live: without -L, a
# second instance -- or this box's own always-on session -- silently
# stole the new session, and this unit cycled "deactivated" forever).
ExecStart=/usr/bin/tmux -L {{CC_TMUX_SOCKET}} new-session -d -s {{CC_TMUX_SESSION}} -x 220 -y 50 {{INSTALL_DIR}}/current/bin/claude-daemon.sh /etc/cc-service/%i.env
ExecStop=/usr/bin/tmux -L {{CC_TMUX_SOCKET}} kill-session -t {{CC_TMUX_SESSION}}
Restart=always
RestartSec=5

# Deliberately light-touch hardening: the daemon runs `claude`, whose tool
# calls need broad filesystem access within the operator's project(s), so
# ProtectSystem/ProtectHome are left off rather than fighting the workload.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
